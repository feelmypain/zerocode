{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["zerocodehighlights"],
  "ios": {
    "iosModuleName": "ZeroCodeHighlightsNative"
  },
  "android": {
    "androidNamespace": ["zerocodehighlights"],
    "androidCxxLibName": "zerocodehighlights"
  },
  "autolinking": {
    "ZeroCodeHighlights": {
      "all": {
        "language": "c++",
        "implementationClassName": "HybridZeroCodeHighlights"
      }
    }
  },
  "ignorePaths": ["node_modules", "Vendor"]
}
