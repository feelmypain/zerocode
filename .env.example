# Optional: ZeroCode Connect source builds
# `cp .env.example .env` enables ZeroCode Connect against your deployment.
# Replace these placeholders with your own public identifiers (not secrets).
# Remove or comment them out to build with cloud features disabled.
# Do not add server-side secrets to this file.

# Clerk instance. Get these from the Clerk Dashboard under API keys, JWT
# templates, and OAuth applications.
ZEROCODE_CLERK_PUBLISHABLE_KEY=pk_test_...
ZEROCODE_CLERK_JWT_TEMPLATE=zerocode-relay
ZEROCODE_CLERK_CLI_OAUTH_CLIENT_ID=replace_with_clerk_oauth_client_id

# Optional: signed macOS passkey builds. The RP domain defaults to the Frontend API
# hostname encoded in ZEROCODE_CLERK_PUBLISHABLE_KEY. Set the override only when Clerk
# returns a different RP ID or when multiple domains must be entitled.
# ZEROCODE_APPLE_TEAM_ID=ABC1234567
# ZEROCODE_MACOS_PROVISIONING_PROFILE=/absolute/path/to/zerocode.provisionprofile
# ZEROCODE_CLERK_PASSKEY_RP_DOMAINS=example.clerk.accounts.dev,clerk.example.com

# Production relay. For a self-hosted relay, `infra/relay` deploys update it
# automatically.
ZEROCODE_RELAY_URL=https://relay.example.com

# Optional: hosted app origin used by the CLI's out-of-band OAuth flow.
# Defaults to http://localhost:3773; override for a self-hosted web deployment.
# ZEROCODE_HOSTED_APP_URL=https://app.example.com
