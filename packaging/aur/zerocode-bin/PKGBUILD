# Maintainer: feelmypain <201408190+feelmypain@users.noreply.github.com>

pkgname=zerocode-bin
pkgver=0.1.7
pkgrel=1
pkgdesc='Desktop control surface for local coding agents'
arch=('x86_64' 'aarch64')
url='https://github.com/feelmypain/zerocode'
license=('MIT')
depends=(
  'alsa-lib'
  'at-spi2-core'
  'cairo'
  'dbus'
  'expat'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gtk3'
  'hicolor-icon-theme'
  'libcups'
  'libdrm'
  'libgcc'
  'libstdc++'
  'libx11'
  'libxcb'
  'libxcomposite'
  'libxdamage'
  'libxext'
  'libxfixes'
  'libxkbcommon'
  'libxrandr'
  'mesa'
  'nspr'
  'nss'
  'pango'
  'systemd-libs'
  'xdg-utils'
  'zlib'
)
optdepends=('openai-codex: use the system-installed Codex CLI')
provides=("zerocode=$pkgver")
conflicts=('zerocode')
options=('!debug' '!strip')

_appimage="ZeroCode-Desktop-${pkgver}-${CARCH/aarch64/arm64}.AppImage"
_asset_x86_64="ZeroCode-Desktop-0.1.7-x86_64.AppImage"
_asset_aarch64="ZeroCode-Desktop-0.1.7-arm64.AppImage"
source=("${pkgname}-${pkgver}-LICENSE::https://raw.githubusercontent.com/feelmypain/zerocode/v${pkgver}/LICENSE")
sha256sums=('935d8f2af0c703f9c39517ee57cc4930b19d02d533be930b63f0e82f93614b43') # upstream license
source_x86_64=("ZeroCode-Desktop-${pkgver}-x86_64.AppImage::https://github.com/feelmypain/zerocode/releases/download/v${pkgver}/$_asset_x86_64")
sha256sums_x86_64=('faaee4094dca1276057840a1a45a6b2d00d7418afbf5735f75a7503b774e63d1')
source_aarch64=("ZeroCode-Desktop-${pkgver}-arm64.AppImage::https://github.com/feelmypain/zerocode/releases/download/v${pkgver}/$_asset_aarch64")
sha256sums_aarch64=('4445beffacf96da3be2c81c280222020e3b2623579e3364b10f44e84bfd1e3c2')

prepare() {
  chmod +x "$srcdir/$_appimage"
  rm -rf "$srcdir/squashfs-root"
  "$srcdir/$_appimage" --appimage-extract >/dev/null

  if [[ ! -x "$srcdir/squashfs-root/AppRun" ||
        ! -f "$srcdir/squashfs-root/chrome-sandbox" ]]; then
    echo 'The AppImage payload is missing its launcher or Chromium sandbox.' >&2
    return 1
  fi
}

package() {
  install -d "$pkgdir/opt/$pkgname"
  cp -a --no-preserve=ownership "$srcdir/squashfs-root/." "$pkgdir/opt/$pkgname/"
  chmod -R u=rwX,go=rX "$pkgdir/opt/$pkgname"
  chmod 4755 "$pkgdir/opt/$pkgname/chrome-sandbox"

  install -Dm755 /dev/stdin "$pkgdir/usr/bin/zerocode" <<'EOF'
#!/bin/sh
# AppRun computes APPDIR but doesn't export it. The server's AppImage env scrub needs it
# to keep /opt/zerocode-bin/usr/lib etc. out of terminal and agent shells (#28993).
exec env APPDIR=/opt/zerocode-bin /opt/zerocode-bin/AppRun "$@"
EOF
  ln -s zerocode "$pkgdir/usr/bin/zerocode-desktop"

  # Icon lookup only sees sizes registered in hicolor's index.theme (max 512x512).
  local icon size_dir
  for icon in "$srcdir"/squashfs-root/usr/share/icons/hicolor/*/apps/zerocode.png; do
    size_dir="${icon%/apps/zerocode.png}"
    install -Dm644 "$icon" \
      "$pkgdir/usr/share/icons/hicolor/${size_dir##*/}/apps/zerocode.png"
  done

  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/zerocode.desktop" <<'EOF'
[Desktop Entry]
Name=ZeroCode
Comment=Desktop control surface for local coding agents
Exec=zerocode %U
TryExec=zerocode
Terminal=false
Type=Application
Icon=zerocode
StartupWMClass=com.zerocode.ZeroCode
Categories=Development;
MimeType=x-scheme-handler/zerocode;
EOF

  install -Dm644 "$srcdir/${pkgname}-${pkgver}-LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
